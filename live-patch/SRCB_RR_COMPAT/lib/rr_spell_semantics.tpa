// Compatibility transforms for Rogue Rebalancing v4.92 and Spell Revisions.
// This library is self-contained so SRCB_RR_COMPAT can be copied to a game
// without the rest of the fork.
//
// Up to v4.21-chriz.7, SR gives Chaos a level-7 wizard identity and turns its
// old level-5 slot into Waves of Fatigue. RR's mages were written for the old
// slot, so their spellbooks prepare Waves of Fatigue and their scripts name it
// where RR meant Chaos. For that layout each affected mage's level-5 Chaos
// copies become a level-5 spell that its script casts instead (Christopher's
// decision, 2026-10-23). Records and references are recognized by the spell
// they name, never by how many of them one installation happened to contain.
//
// From v4.21-chriz.8, SR keeps Chaos at wizard level 5 (Christopher's decision,
// 2026-10-27). RR's level-5 Chaos copies and casts are real Chaos again and
// stay. Either way SR's spell behind Spell Turning raises the Spell Deflection
// stat, so Selina's self-recast guard changes.


// Regexp alternation of every SPELL.IDS symbol for one spell number. The script
// decompiler prints the last of several same-number symbols, so a reference can
// appear under any of them. IDS values may be decimal or hexadecimal (0x...),
// as the engine and WeiDU read both.
DEFINE_ACTION_FUNCTION srcb_rr_spell_symbols
    INT_VAR number = 0
    RET symbols
BEGIN
    OUTER_TEXT_SPRINT symbols ~~
    COPY_EXISTING ~spell.ids~ ~override~
        REPLACE_EVALUATE CASE_INSENSITIVE
            ~^[ %TAB%]*\(0[xX][0-9A-Fa-f]+\|[0-9]+\)[ %TAB%]+\([A-Za-z0-9_#]+\)~
        BEGIN
            PATCH_IF (MATCH1 = number) BEGIN
                PATCH_IF (~%symbols%~ STRING_EQUAL ~~) BEGIN
                    TEXT_SPRINT symbols ~%MATCH2%~
                END ELSE BEGIN
                    TEXT_SPRINT symbols ~%symbols%\|%MATCH2%~
                END
            END
        END ~%MATCH0%~
    BUT_ONLY
    ACTION_IF (~%symbols%~ STRING_EQUAL ~~) BEGIN
        FAIL ~SRCB_RR_COMPAT: SPELL.IDS has no readable symbol for spell %number%.~
    END
END


// Removes the 12-byte known-spell record at `entry`. Every table stored after
// it moves down by one record.
DEFINE_PATCH_FUNCTION srcb_rr_remove_known_record
    INT_VAR entry = 0
BEGIN
    DELETE_BYTES entry 0x0c
    WRITE_LONG 0x2a4 ((LONG_AT 0x2a4) - 1)
    PATCH_IF ((LONG_AT 0x2a8) > entry) BEGIN
        WRITE_LONG 0x2a8 ((LONG_AT 0x2a8) - 0x0c)
    END
    PATCH_IF ((LONG_AT 0x2b0) > entry) BEGIN
        WRITE_LONG 0x2b0 ((LONG_AT 0x2b0) - 0x0c)
    END
    PATCH_IF ((LONG_AT 0x2b8) > entry) BEGIN
        WRITE_LONG 0x2b8 ((LONG_AT 0x2b8) - 0x0c)
    END
    PATCH_IF ((LONG_AT 0x2bc) > entry) BEGIN
        WRITE_LONG 0x2bc ((LONG_AT 0x2bc) - 0x0c)
    END
    PATCH_IF ((LONG_AT 0x2c4) > entry) BEGIN
        WRITE_LONG 0x2c4 ((LONG_AT 0x2c4) - 0x0c)
    END
END


// RR's prepared level-5 Chaos copies hold Waves of Fatigue under SR. Each one
// becomes `replacement_spell` where it stands, with its own flags (prepared or
// already cast): the table keeps its size and layout, and no slot counter
// changes. A wizard's known records stay as they are. A sorcerer casts from
// its known list, so its known old-slot record becomes the replacement too, or
// is removed when the replacement is already known: no spell is known twice.
// Sorcerer (19) is the engine's only class that casts wizard spells from its
// known list.
DEFINE_PATCH_FUNCTION srcb_rr_replace_chaos_copies
    INT_VAR source_level = 4
    STR_VAR
        resource_name = ""
        source_spell = ""
        chaos_spell = ""
        replacement_spell = ""
BEGIN
    SET srcb_valid_cre = 0
    PATCH_IF (SOURCE_SIZE > 0x2d3) BEGIN
        READ_ASCII 0 srcb_signature (8)
        READ_BYTE 0x33 srcb_effect_version
        READ_LONG 0x2a0 srcb_known_offset
        READ_LONG 0x2a4 srcb_known_count
        READ_LONG 0x2a8 srcb_info_offset
        READ_LONG 0x2ac srcb_info_count
        READ_LONG 0x2b0 srcb_memorized_offset
        READ_LONG 0x2b4 srcb_memorized_count
        READ_LONG 0x2b8 srcb_slots_offset
        READ_LONG 0x2bc srcb_items_offset
        READ_LONG 0x2c0 srcb_items_count
        READ_LONG 0x2c4 srcb_effects_offset
        READ_LONG 0x2c8 srcb_effects_count
        SET srcb_effect_stride = 0
        PATCH_IF (srcb_effect_version = 0) BEGIN
            SET srcb_effect_stride = 0x30
        END ELSE PATCH_IF (srcb_effect_version = 1) BEGIN
            SET srcb_effect_stride = 0x108
        END
        PATCH_IF (~%srcb_signature%~ STRING_EQUAL_CASE ~CRE V1.0~)
              AND (srcb_effect_stride > 0)
              AND (srcb_known_offset >= 0x2d4)
              AND (srcb_known_offset + srcb_known_count * 0x0c <= SOURCE_SIZE)
              AND (srcb_info_offset >= 0x2d4)
              AND (srcb_info_offset + srcb_info_count * 0x10 <= SOURCE_SIZE)
              AND (srcb_memorized_offset >= 0x2d4)
              AND (srcb_memorized_offset + srcb_memorized_count * 0x0c <= SOURCE_SIZE)
              AND (srcb_slots_offset >= 0x2d4)
              AND (srcb_slots_offset + 0x50 <= SOURCE_SIZE)
              AND (srcb_items_offset >= 0x2d4)
              AND (srcb_items_offset + srcb_items_count * 0x14 <= SOURCE_SIZE)
              AND (srcb_effects_offset >= 0x2d4)
              AND (srcb_effects_offset + srcb_effects_count * srcb_effect_stride <= SOURCE_SIZE) BEGIN
            SET srcb_valid_cre = 1
            FOR (srcb_i = 0; (srcb_i < srcb_info_count) AND (srcb_valid_cre = 1); ++srcb_i) BEGIN
                SET srcb_info = srcb_info_offset + srcb_i * 0x10
                READ_LONG (srcb_info + 0x08) srcb_first
                READ_LONG (srcb_info + 0x0c) srcb_count
                PATCH_IF (srcb_first + srcb_count > srcb_memorized_count) BEGIN
                    SET srcb_valid_cre = 0
                END
            END
        END
    END
    PATCH_IF (srcb_valid_cre = 0) BEGIN
        PATCH_FAIL ~SRCB_RR_COMPAT: %resource_name%.CRE has an invalid or unsupported CRE V1.0 structure.~
    END

    SET srcb_source_known = 0
    SET srcb_source_known_book = 0
    SET srcb_chaos_known = 0
    SET srcb_replacement_known_book = 0
    FOR (srcb_i = 0; srcb_i < srcb_known_count; ++srcb_i) BEGIN
        SET srcb_entry = srcb_known_offset + srcb_i * 0x0c
        READ_ASCII srcb_entry srcb_spell (8) NULL
        SET srcb_in_book = (SHORT_AT (srcb_entry + 0x08) = source_level) AND (SHORT_AT (srcb_entry + 0x0a) = 1)
        PATCH_IF (~%srcb_spell%~ STRING_EQUAL_CASE ~%source_spell%~) BEGIN
            SET srcb_source_known += 1
            SET srcb_source_known_book += srcb_in_book
        END
        PATCH_IF (~%srcb_spell%~ STRING_EQUAL_CASE ~%chaos_spell%~) BEGIN
            SET srcb_chaos_known += 1
        END
        PATCH_IF (~%srcb_spell%~ STRING_EQUAL_CASE ~%replacement_spell%~) BEGIN
            SET srcb_replacement_known_book += srcb_in_book
        END
    END
    SET srcb_chaos_prepared = 0
    FOR (srcb_i = 0; srcb_i < srcb_memorized_count; ++srcb_i) BEGIN
        READ_ASCII (srcb_memorized_offset + srcb_i * 0x0c) srcb_spell (8) NULL
        PATCH_IF (~%srcb_spell%~ STRING_EQUAL_CASE ~%chaos_spell%~) BEGIN
            SET srcb_chaos_prepared += 1
        END
    END
    // A prepared copy is cast through the memorization row that holds it.
    SET srcb_source_book = 0
    SET srcb_source_outside = 0
    SET srcb_replacement_book = 0
    FOR (srcb_i = 0; srcb_i < srcb_info_count; ++srcb_i) BEGIN
        SET srcb_info = srcb_info_offset + srcb_i * 0x10
        SET srcb_book_row = (SHORT_AT srcb_info = source_level) AND (SHORT_AT (srcb_info + 0x06) = 1)
        READ_LONG (srcb_info + 0x08) srcb_first
        READ_LONG (srcb_info + 0x0c) srcb_count
        FOR (srcb_j = 0; srcb_j < srcb_count; ++srcb_j) BEGIN
            READ_ASCII (srcb_memorized_offset + (srcb_first + srcb_j) * 0x0c) srcb_spell (8) NULL
            PATCH_IF (~%srcb_spell%~ STRING_EQUAL_CASE ~%source_spell%~) BEGIN
                PATCH_IF srcb_book_row BEGIN
                    SET srcb_source_book += 1
                END ELSE BEGIN
                    SET srcb_source_outside += 1
                END
            END
            PATCH_IF srcb_book_row AND (~%srcb_spell%~ STRING_EQUAL_CASE ~%replacement_spell%~) BEGIN
                SET srcb_replacement_book += 1
            END
        END
    END
    SET srcb_source_prepared = srcb_source_book + srcb_source_outside

    PATCH_IF (srcb_source_prepared = 0) BEGIN
        // Known-only old-slot records are not RR's prepared Chaos; a creature
        // that already prepares the replacement needs nothing.
        PATCH_IF (srcb_replacement_book = 0) BEGIN
            PATCH_WARN
                ~SRCB_RR_COMPAT: %resource_name%.CRE prepares neither %source_spell% (RR's Chaos slot, now Waves of Fatigue) nor %replacement_spell% at level 5; its spellbook is left unchanged.~
        END
    END ELSE BEGIN
        // Old-slot copies alongside Chaos could be a later mod's intended Waves
        // of Fatigue.
        PATCH_IF (srcb_chaos_known + srcb_chaos_prepared > 0) BEGIN
            PATCH_FAIL
                ~SRCB_RR_COMPAT: %resource_name%.CRE names both %source_spell% (RR's Chaos slot, now Waves of Fatigue) and %chaos_spell% (Chaos): known %srcb_source_known% and %srcb_chaos_known%, prepared %srcb_source_prepared% and %srcb_chaos_prepared%. Which %source_spell% records RR meant as Chaos is ambiguous.~
        END
        // A copy shared with another level's row would change that row's
        // spell too.
        FOR (srcb_i = 0; srcb_i < srcb_info_count; ++srcb_i) BEGIN
            SET srcb_info = srcb_info_offset + srcb_i * 0x10
            SET srcb_book_row = (SHORT_AT srcb_info = source_level) AND (SHORT_AT (srcb_info + 0x06) = 1)
            READ_LONG (srcb_info + 0x08) srcb_first
            READ_LONG (srcb_info + 0x0c) srcb_count
            FOR (srcb_j = 0; srcb_j < srcb_i; ++srcb_j) BEGIN
                SET srcb_other = srcb_info_offset + srcb_j * 0x10
                SET srcb_other_book_row = (SHORT_AT srcb_other = source_level) AND (SHORT_AT (srcb_other + 0x06) = 1)
                READ_LONG (srcb_other + 0x08) srcb_other_first
                READ_LONG (srcb_other + 0x0c) srcb_other_count
                SET srcb_from = (srcb_first > srcb_other_first) ? srcb_first : srcb_other_first
                SET srcb_to = (srcb_first + srcb_count < srcb_other_first + srcb_other_count)
                    ? (srcb_first + srcb_count) : (srcb_other_first + srcb_other_count)
                PATCH_IF srcb_book_row AND srcb_other_book_row BEGIN
                    SET srcb_to = srcb_from
                END
                FOR (srcb_k = srcb_from; srcb_k < srcb_to; ++srcb_k) BEGIN
                    READ_ASCII (srcb_memorized_offset + srcb_k * 0x0c) srcb_spell (8) NULL
                    PATCH_IF (~%srcb_spell%~ STRING_EQUAL_CASE ~%source_spell%~) BEGIN
                        PATCH_FAIL
                            ~SRCB_RR_COMPAT: %resource_name%.CRE memorization rows %srcb_j% and %srcb_i% share prepared records; renaming Chaos copies would change another spell level.~
                    END
                END
            END
        END
        PATCH_IF (srcb_source_outside > 0) BEGIN
            PATCH_FAIL
                ~SRCB_RR_COMPAT: %resource_name%.CRE has %source_spell% prepared outside its level-5 wizard row (%srcb_source_book% of %srcb_source_prepared% copies there); those copies cannot be attributed to RR's Chaos.~
        END
        SET srcb_sorcerer = (BYTE_AT 0x273 = 19)
        PATCH_IF srcb_sorcerer AND (srcb_source_known_book != srcb_source_known) BEGIN
            PATCH_FAIL
                ~SRCB_RR_COMPAT: %resource_name%.CRE knows %source_spell% outside its level-5 wizard book (%srcb_source_known_book% of %srcb_source_known% known records there); those records cannot be attributed to RR's Chaos.~
        END

        FOR (srcb_i = 0; srcb_i < srcb_info_count; ++srcb_i) BEGIN
            SET srcb_info = srcb_info_offset + srcb_i * 0x10
            PATCH_IF (SHORT_AT srcb_info = source_level) AND (SHORT_AT (srcb_info + 0x06) = 1) BEGIN
                READ_LONG (srcb_info + 0x08) srcb_first
                READ_LONG (srcb_info + 0x0c) srcb_count
                FOR (srcb_j = 0; srcb_j < srcb_count; ++srcb_j) BEGIN
                    SET srcb_record = srcb_memorized_offset + (srcb_first + srcb_j) * 0x0c
                    READ_ASCII srcb_record srcb_spell (8) NULL
                    PATCH_IF (~%srcb_spell%~ STRING_EQUAL_CASE ~%source_spell%~) BEGIN
                        WRITE_ASCIIE srcb_record ~%replacement_spell%~ #8
                    END
                END
            END
        END

        PATCH_IF srcb_sorcerer BEGIN
            SET srcb_i = 0
            WHILE (srcb_i < srcb_known_count) BEGIN
                SET srcb_entry = srcb_known_offset + srcb_i * 0x0c
                READ_ASCII srcb_entry srcb_spell (8) NULL
                PATCH_IF NOT (~%srcb_spell%~ STRING_EQUAL_CASE ~%source_spell%~) BEGIN
                    SET srcb_i += 1
                END ELSE PATCH_IF (srcb_replacement_known_book = 0) BEGIN
                    WRITE_ASCIIE srcb_entry ~%replacement_spell%~ #8
                    SET srcb_replacement_known_book = 1
                    SET srcb_i += 1
                END ELSE BEGIN
                    LPF srcb_rr_remove_known_record INT_VAR entry = srcb_entry END
                    SET srcb_known_count -= 1
                END
            END
        END
    END
END


// Appends to `missing` each of `filters` (separated by whitespace, <target>
// standing for the cast's target object) that neither `triggers` nor `missing`
// already has, as one trigger line. A decompiled trigger line ends at the line
// break or at the comment the decompiler adds to some of them.
DEFINE_PATCH_FUNCTION srcb_rr_missing_filters
    STR_VAR
        filters = ""
        target = ""
        triggers = ""
        missing = ""
    RET missing
BEGIN
    INNER_PATCH ~%filters%~ BEGIN
        REPLACE_EVALUATE CASE_SENSITIVE ~[^ %TAB%%MNL%%LNL%]+~ BEGIN
            INNER_PATCH_SAVE srcb_filter ~%MATCH0%~ BEGIN
                REPLACE_TEXTUALLY CASE_SENSITIVE EXACT_MATCH ~<target>~ ~%target%~
            END
            SET srcb_present = (INDEX (CASE_INSENSITIVE EXACT_MATCH ~%srcb_filter%%MNL%~ ~%triggers%~) >= 0)
                OR (INDEX (CASE_INSENSITIVE EXACT_MATCH ~%srcb_filter%%LNL%~ ~%triggers%~) >= 0)
                OR (INDEX (CASE_INSENSITIVE EXACT_MATCH ~%srcb_filter% ~ ~%triggers%~) >= 0)
                OR (INDEX (CASE_INSENSITIVE EXACT_MATCH ~%srcb_filter%%TAB%~ ~%triggers%~) >= 0)
            PATCH_IF (srcb_present = 0)
                  AND (INDEX (CASE_INSENSITIVE EXACT_MATCH ~%srcb_filter%%LNL%~ ~%missing%~) < 0) BEGIN
                TEXT_SPRINT missing ~%missing%  %srcb_filter%%LNL%~
            END
        END ~%MATCH0%~
    END
END


// RR wrote these scripts for Chaos's old slot and names it only by the
// WIZARD_CHAOS symbol. Compiled before SR, the references decompile as the old
// slot (now Waves of Fatigue); compiled after SR, as SR's level-7 Chaos, which
// these mages do not prepare. Either way every reference now names
// `replacement`, the level-5 spell their spellbooks prepare instead. A script
// naming both slots could hold a later mod's intended Waves of Fatigue or
// Chaos, so it is not guessed at.
//
// A block that casts Chaos at a target it picked (Spell, SpellNoDec) keeps its
// filters and gains each of `filters` it lacks, for the same target object:
// what the replacement needs that Chaos did not. A forced cast (Selina's
// opening Spell Trigger) is a scripted sequence; only its spell changes.
DEFINE_PATCH_FUNCTION srcb_rr_retarget_chaos_script
    STR_VAR
        resource_name = ""
        old_symbols = ""
        chaos_symbols = ""
        replacement = ""
        replacement_symbols = ""
        filters = ""
BEGIN
    COUNT_REGEXP_INSTANCES CASE_SENSITIVE ~[(,]\(%old_symbols%\)[),]~ srcb_old_count
    COUNT_REGEXP_INSTANCES CASE_SENSITIVE ~[(,]\(%chaos_symbols%\)[),]~ srcb_chaos_count
    PATCH_IF (srcb_old_count > 0) AND (srcb_chaos_count > 0) BEGIN
        PATCH_FAIL
            ~SRCB_RR_COMPAT: %resource_name%.BCS names both Waves of Fatigue (%srcb_old_count% references) and Chaos (%srcb_chaos_count%); which of them RR meant as Chaos is ambiguous.~
    END ELSE PATCH_IF (srcb_old_count + srcb_chaos_count = 0) BEGIN
        COUNT_REGEXP_INSTANCES CASE_SENSITIVE ~[(,]\(%replacement_symbols%\)[),]~ srcb_replacement_count
        PATCH_IF (srcb_replacement_count = 0) BEGIN
            PATCH_WARN
                ~SRCB_RR_COMPAT: %resource_name%.BCS names neither Waves of Fatigue nor Chaos, and not %replacement% either; it is left unchanged.~
        END
    END ELSE BEGIN
        PATCH_IF (srcb_old_count > 0) BEGIN
            TEXT_SPRINT srcb_symbols ~%old_symbols%~
        END ELSE BEGIN
            TEXT_SPRINT srcb_symbols ~%chaos_symbols%~
        END
        SET srcb_at = INDEX_BUFFER (CASE_SENSITIVE ~^IF~)
        WHILE (srcb_at >= 0) BEGIN
            SET srcb_then = INDEX_BUFFER (CASE_SENSITIVE ~^THEN~ srcb_at)
            SET srcb_end = INDEX_BUFFER (CASE_SENSITIVE ~^END~ srcb_at)
            PATCH_IF (srcb_then < 0) OR (srcb_end < srcb_then) BEGIN
                PATCH_FAIL ~SRCB_RR_COMPAT: %resource_name%.BCS decompiled to an unrecognized block layout.~
            END
            READ_ASCII srcb_at srcb_triggers (srcb_then - srcb_at)
            READ_ASCII srcb_then srcb_actions (srcb_end - srcb_then)
            TEXT_SPRINT srcb_missing ~~
            INNER_PATCH ~%srcb_actions%~ BEGIN
                REPLACE_EVALUATE CASE_SENSITIVE
                    ~\b\(Spell\|SpellNoDec\)(\([^,]+\),\(%srcb_symbols%\))~
                BEGIN
                    TEXT_SPRINT srcb_target ~%MATCH2%~
                    LPF srcb_rr_missing_filters
                        STR_VAR
                            filters = EVAL ~%filters%~
                            target = EVAL ~%srcb_target%~
                            triggers = EVAL ~%srcb_triggers%~
                            missing = EVAL ~%srcb_missing%~
                        RET srcb_missing = missing
                    END
                END ~%MATCH0%~
            END
            PATCH_IF (STRING_LENGTH ~%srcb_missing%~ > 0) BEGIN
                INSERT_BYTES srcb_then (STRING_LENGTH ~%srcb_missing%~)
                WRITE_ASCIIE srcb_then ~%srcb_missing%~
                SET srcb_end += STRING_LENGTH ~%srcb_missing%~
            END
            SET srcb_at = INDEX_BUFFER (CASE_SENSITIVE ~^IF~ srcb_end)
        END
        // Adjacent references share a delimiter, so repeat until none is left.
        SET srcb_left = srcb_old_count + srcb_chaos_count
        WHILE (srcb_left > 0) BEGIN
            REPLACE_TEXTUALLY CASE_SENSITIVE
                ~\([(,]\)\(%srcb_symbols%\)\([),]\)~
                ~\1%replacement%\3~
            COUNT_REGEXP_INSTANCES CASE_SENSITIVE ~[(,]\(%srcb_symbols%\)[),]~ srcb_left
        END
    END
END


// Whether a decompiled response list casts spell `number` on Myself.
DEFINE_PATCH_FUNCTION srcb_rr_casts_on_self
    INT_VAR number = 0
    STR_VAR actions = ""
    RET hit
BEGIN
    SET hit = 0
    INNER_PATCH ~%actions%~ BEGIN
        REPLACE_EVALUATE CASE_SENSITIVE
            ~\(Spell\|SpellNoDec\|ForceSpell\|ReallyForceSpell\)(Myself,\([A-Za-z0-9_#]+\))~
        BEGIN
            PATCH_IF (IS_AN_INT MATCH2) BEGIN
                PATCH_IF (MATCH2 = number) BEGIN
                    SET hit = 1
                END
            END ELSE PATCH_IF (IDS_OF_SYMBOL (~spell~ ~%MATCH2%~) = number) BEGIN
                SET hit = 1
            END
        END ~%MATCH0%~
    END
END


// Selina's self-recast block casts the Spell Turning identifier on herself and
// skips the cast while her Spell Turning stat is up. SR's spell behind that
// identifier raises the Spell Deflection stat instead, so her guard must check
// that. Only guards in blocks casting that identifier on Myself change; her
// Spell Turning checks on enemies, or before other spells, keep their meaning.
DEFINE_PATCH_FUNCTION srcb_rr_fix_selina_deflection_guard
    INT_VAR turning_number = 0
    STR_VAR resource_name = ""
BEGIN
    SET srcb_corrected = 0
    SET srcb_already = 0
    TEXT_SPRINT srcb_new_guard ~!CheckStatGT(Myself,0,WIZARD_SPELL_DEFLECTION)~
    PATCH_FOR_EACH srcb_stat IN ~WIZARD_SPELL_DEFLECTION~ ~WIZARD_SPELL_TURNING~ BEGIN
        TEXT_SPRINT srcb_guard ~!CheckStatGT(Myself,0,%srcb_stat%)~
        SET srcb_at = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%srcb_guard%~)
        WHILE (srcb_at >= 0) BEGIN
            SET srcb_then = INDEX_BUFFER (CASE_SENSITIVE ~^THEN~ srcb_at)
            SET srcb_end = INDEX_BUFFER (CASE_SENSITIVE ~^END~ srcb_at)
            PATCH_IF (srcb_then < 0) OR (srcb_end < srcb_then) BEGIN
                PATCH_FAIL ~SRCB_RR_COMPAT: %resource_name%.BCS decompiled to an unrecognized block layout.~
            END
            READ_ASCII srcb_then srcb_actions (srcb_end - srcb_then)
            LPF srcb_rr_casts_on_self
                INT_VAR number = turning_number
                STR_VAR actions = EVAL ~%srcb_actions%~
                RET srcb_self_cast = hit
            END
            PATCH_IF srcb_self_cast BEGIN
                PATCH_IF (~%srcb_stat%~ STRING_EQUAL ~WIZARD_SPELL_TURNING~) BEGIN
                    DELETE_BYTES srcb_at (STRING_LENGTH ~%srcb_guard%~)
                    INSERT_BYTES srcb_at (STRING_LENGTH ~%srcb_new_guard%~)
                    WRITE_ASCIIE srcb_at ~%srcb_new_guard%~
                    SET srcb_corrected += 1
                END ELSE BEGIN
                    SET srcb_already += 1
                END
            END
            SET srcb_at = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%srcb_guard%~ (srcb_at + 1))
        END
    END
    PATCH_IF (srcb_corrected + srcb_already = 0) BEGIN
        PATCH_WARN
            ~SRCB_RR_COMPAT: %resource_name%.BCS has no self-recast of Spell Turning guarded by her Turning or Deflection stat; nothing to correct.~
    END
END


DEFINE_ACTION_FUNCTION srcb_rr_patch_cre_resource
    INT_VAR source_level = 4
    STR_VAR
        resource_name = ""
        source_spell = ""
        chaos_spell = ""
        replacement_spell = ""
BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%resource_name%.cre~ BEGIN
        COPY_EXISTING ~%resource_name%.cre~ ~override~
            LPF srcb_rr_replace_chaos_copies
                INT_VAR source_level = source_level
                STR_VAR
                    resource_name = EVAL ~%resource_name%~
                    source_spell = EVAL ~%source_spell%~
                    chaos_spell = EVAL ~%chaos_spell%~
                    replacement_spell = EVAL ~%replacement_spell%~
            END
        BUT_ONLY
    END ELSE BEGIN
        WARN ~SRCB_RR_COMPAT: %resource_name%.CRE is not in the game; there is no spellbook to change.~
    END
END


DEFINE_ACTION_FUNCTION srcb_rr_patch_script_resource
    INT_VAR
        patch_selina_guard = 0
        turning_number = 0
    STR_VAR
        resource_name = ""
        old_symbols = ""
        chaos_symbols = ""
        replacement = ""
        replacement_symbols = ""
        filters = ""
BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%resource_name%.bcs~ BEGIN
        COPY_EXISTING ~%resource_name%.bcs~ ~override~
            DECOMPILE_AND_PATCH BEGIN
                LPF srcb_rr_retarget_chaos_script
                    STR_VAR
                        resource_name = EVAL ~%resource_name%~
                        old_symbols = EVAL ~%old_symbols%~
                        chaos_symbols = EVAL ~%chaos_symbols%~
                        replacement = EVAL ~%replacement%~
                        replacement_symbols = EVAL ~%replacement_symbols%~
                        filters = EVAL ~%filters%~
                END
                PATCH_IF (patch_selina_guard = 1) BEGIN
                    LPF srcb_rr_fix_selina_deflection_guard
                        INT_VAR turning_number = turning_number
                        STR_VAR resource_name = EVAL ~%resource_name%~
                    END
                END
            END
        BUT_ONLY
    END ELSE BEGIN
        WARN ~SRCB_RR_COMPAT: %resource_name%.BCS is not in the game; there is no script to change.~
    END
END


DEFINE_ACTION_FUNCTION srcb_rr_require_wizard_spell
    INT_VAR expected_level = 1
    STR_VAR resource_name = ""
BEGIN
    ACTION_IF NOT FILE_EXISTS_IN_GAME ~%resource_name%.spl~ BEGIN
        FAIL ~SRCB_RR_COMPAT: required spell %resource_name%.SPL does not exist.~
    END
    COPY_EXISTING ~%resource_name%.spl~ ~override~
        PATCH_IF (SOURCE_SIZE < 0x38) BEGIN
            PATCH_FAIL ~SRCB_RR_COMPAT: %resource_name%.SPL is too small to be a valid spell.~
        END
        READ_ASCII 0 srcb_spell_signature (8)
        READ_SHORT 0x1c srcb_spell_type
        READ_LONG 0x34 srcb_spell_level
        PATCH_IF NOT (~%srcb_spell_signature%~ STRING_EQUAL_CASE ~SPL V1  ~)
              OR (srcb_spell_type != 1)
              OR (srcb_spell_level != expected_level) BEGIN
            PATCH_FAIL
                ~SRCB_RR_COMPAT: %resource_name%.SPL is not the expected level-%expected_level% wizard spell.~
        END
    BUT_ONLY
END


// The level-5 wizard spell a replacement symbol names in the final SPELL.IDS,
// and every symbol of its number.
DEFINE_ACTION_FUNCTION srcb_rr_resolve_replacement
    INT_VAR old_number = 0
    STR_VAR symbol = ""
    RET spell symbols
BEGIN
    OUTER_SET srcb_number = IDS_OF_SYMBOL (~spell~ ~%symbol%~)
    ACTION_IF (srcb_number < 2501) OR (srcb_number > 2599) OR (srcb_number = old_number) BEGIN
        FAIL
            ~SRCB_RR_COMPAT: final SPELL.IDS must map %symbol% to a level-5 wizard spell other than Waves of Fatigue.~
    END
    LAF RES_NUM_OF_SPELL_NAME
        STR_VAR spell_name = EVAL ~%symbol%~
        RET spell = spell_res
    END
    OUTER_TEXT_SPRINT spell ~%spell%~
    ACTION_TO_UPPER spell
    LAF srcb_rr_require_wizard_spell
        INT_VAR expected_level = 5
        STR_VAR resource_name = EVAL ~%spell%~
    END
    LAF srcb_rr_spell_symbols
        INT_VAR number = srcb_number
        RET symbols
    END
END


// WeiDU reports a script symbol that the game's IDS file lacks, but can still
// compile it as 0, which would silently change a filter. Every symbol the
// added filters name must therefore exist first.
DEFINE_ACTION_FUNCTION srcb_rr_require_filter_symbols
    STR_VAR
        ids = ""
        symbols = ""
BEGIN
    OUTER_PATCH ~%symbols%~ BEGIN
        REPLACE_EVALUATE CASE_SENSITIVE ~[^ %TAB%%MNL%%LNL%]+~ BEGIN
            PATCH_IF (IDS_OF_SYMBOL (~%ids%~ ~%MATCH0%~) < 0) BEGIN
                PATCH_FAIL
                    ~SRCB_RR_COMPAT: %ids%.IDS has no %MATCH0%, which the filters added to RR's casting blocks name.~
            END
        END ~%MATCH0%~
    END
END


DEFINE_ACTION_FUNCTION srcb_rr_apply_spell_semantics
BEGIN
    OUTER_SET srcb_chaos_number = IDS_OF_SYMBOL (~spell~ ~WIZARD_CHAOS~)
    ACTION_IF (srcb_chaos_number >= 2501) AND (srcb_chaos_number <= 2599) BEGIN
        LAF srcb_rr_keep_level5_chaos END
    END ELSE BEGIN
        LAF srcb_rr_replace_level7_chaos END
    END
END


// SR from v4.21-chriz.8: Chaos is the level-5 spell RR wrote for, so RR's
// spellbooks and casts stay. Only Selina's Spell Turning guard changes.
DEFINE_ACTION_FUNCTION srcb_rr_keep_level5_chaos
BEGIN
    LAF RES_NUM_OF_SPELL_NAME
        STR_VAR spell_name = ~WIZARD_CHAOS~
        RET srcb_chaos_spell = spell_res
    END
    OUTER_TEXT_SPRINT srcb_chaos_spell ~%srcb_chaos_spell%~
    ACTION_TO_UPPER srcb_chaos_spell
    LAF srcb_rr_require_wizard_spell
        INT_VAR expected_level = 5
        STR_VAR resource_name = EVAL ~%srcb_chaos_spell%~
    END
    PRINT ~SRCB_RR_COMPAT: Chaos is the level-5 spell %srcb_chaos_spell%; RR's Chaos spellbooks and casts stay as they are.~

    ACTION_IF MOD_IS_INSTALLED ~rr/setup-rr.tp2~ 11 BEGIN
        OUTER_SET srcb_turning_number = IDS_OF_SYMBOL (~spell~ ~WIZARD_SPELL_TURNING~)
        ACTION_IF (srcb_turning_number < 0) BEGIN
            FAIL
                ~SRCB_RR_COMPAT: SPELL.IDS has no WIZARD_SPELL_TURNING, so Selina's Spell Turning self-recast block cannot be identified.~
        END
        ACTION_IF (IDS_OF_SYMBOL (~STATS~ ~WIZARD_SPELL_DEFLECTION~) < 0) BEGIN
            FAIL
                ~SRCB_RR_COMPAT: STATS.IDS has no WIZARD_SPELL_DEFLECTION, which Selina's corrected guard names.~
        END
        ACTION_IF FILE_EXISTS_IN_GAME ~rr#seli.bcs~ BEGIN
            COPY_EXISTING ~rr#seli.bcs~ ~override~
                DECOMPILE_AND_PATCH BEGIN
                    LPF srcb_rr_fix_selina_deflection_guard
                        INT_VAR turning_number = srcb_turning_number
                        STR_VAR resource_name = ~RR#SELI~
                    END
                END
            BUT_ONLY
        END ELSE BEGIN
            WARN ~SRCB_RR_COMPAT: RR#SELI.BCS is not in the game; there is no script to change.~
        END
    END
END


// SR up to v4.21-chriz.7: Chaos is a level-7 spell and Waves of Fatigue holds
// RR's level-5 Chaos slot.
DEFINE_ACTION_FUNCTION srcb_rr_replace_level7_chaos
BEGIN
    OUTER_SET srcb_source_number = IDS_OF_SYMBOL (~spell~ ~WIZARD_WAVES_OF_FATIGUE~)
    OUTER_SET srcb_chaos_number = IDS_OF_SYMBOL (~spell~ ~WIZARD_CHAOS~)
    OUTER_SET srcb_sphere_number = IDS_OF_SYMBOL (~spell~ ~WIZARD_SPHERE_OF_CHAOS~)
    // A Sphere of Chaos symbol naming another spell would leave two candidates
    // for Chaos.
    ACTION_IF (srcb_source_number < 2001)
          OR (srcb_source_number > 2999)
          OR (srcb_chaos_number < 2001)
          OR (srcb_chaos_number > 2999)
          OR (srcb_source_number = srcb_chaos_number)
          OR ((srcb_sphere_number >= 0) AND (srcb_sphere_number != srcb_chaos_number)) BEGIN
        FAIL
            ~SRCB_RR_COMPAT: final SPELL.IDS must map WIZARD_WAVES_OF_FATIGUE and WIZARD_CHAOS to two different wizard spells, and WIZARD_SPHERE_OF_CHAOS, if present, to the same spell as WIZARD_CHAOS.~
    END

    LAF RES_NUM_OF_SPELL_NAME
        STR_VAR spell_name = ~WIZARD_WAVES_OF_FATIGUE~
        RET srcb_source_spell = spell_res
    END
    LAF RES_NUM_OF_SPELL_NAME
        STR_VAR spell_name = ~WIZARD_CHAOS~
        RET srcb_chaos_spell = spell_res
    END
    OUTER_TEXT_SPRINT srcb_source_spell ~%srcb_source_spell%~
    OUTER_TEXT_SPRINT srcb_chaos_spell ~%srcb_chaos_spell%~
    ACTION_TO_UPPER srcb_source_spell
    ACTION_TO_UPPER srcb_chaos_spell
    OUTER_SET srcb_source_level = ((srcb_source_number - 2000) / 100) - 1
    OUTER_SET srcb_chaos_level = ((srcb_chaos_number - 2000) / 100) - 1
    ACTION_IF (srcb_source_level != 4) OR (srcb_chaos_level != 6) BEGIN
        FAIL
            ~SRCB_RR_COMPAT: expected Waves of Fatigue at wizard level 5 and Chaos at wizard level 7 in final SPELL.IDS.~
    END
    LAF srcb_rr_require_wizard_spell
        INT_VAR expected_level = 5
        STR_VAR resource_name = EVAL ~%srcb_source_spell%~
    END
    LAF srcb_rr_require_wizard_spell
        INT_VAR expected_level = 7
        STR_VAR resource_name = EVAL ~%srcb_chaos_spell%~
    END
    LAF srcb_rr_spell_symbols
        INT_VAR number = srcb_source_number
        RET srcb_old_symbols = symbols
    END
    LAF srcb_rr_spell_symbols
        INT_VAR number = srcb_chaos_number
        RET srcb_chaos_symbols = symbols
    END

    // What each replacement needs that Chaos did not, as RR checks it in its
    // own blocks for the same spell or effect (<target> is the cast's target).
    // Feeblemind and Domination are single-target spells, which Spell Turning,
    // Spell Deflection, Spell Trap and Shield of the Archons stop or reflect;
    // Chaos and SR's Hold Monster use area projectiles. Hold Monster also fails
    // on free action, the hold-immune kits and the items RR's Hold Person
    // blocks name, and on undead (RR's Chaos blocks already skip them).
    // Domination also fails on the charm-immune items RR's Domination blocks
    // name. Saving-throw thresholds and difficulty gates are tactics and stay.
    OUTER_TEXT_SPRINT srcb_single_target_filters
        ~!CheckStatGT(<target>,0,WIZARD_SPELL_TURNING)
         !CheckStatGT(<target>,0,WIZARD_SPELL_DEFLECTION)
         !CheckStatGT(<target>,0,WIZARD_SPELL_TRAP)
         !CheckStat(<target>,1,CLERIC_SHIELD_OF_THE_ARCHONS)~
    OUTER_TEXT_SPRINT srcb_domination_filters
        ~%srcb_single_target_filters%
         !HasItemEquiped("HELM06",<target>)
         !HasItemEquiped("SHLD25",<target>)
         !HasItemEquipedReal("SPER07",<target>)
         !HasItemEquipedReal("SW1H35",<target>)
         !HasItemEquipedReal("SW2H14",<target>)~
    OUTER_TEXT_SPRINT srcb_hold_filters
        ~!General(<target>,UNDEAD)
         !CheckStatGT(<target>,0,CLERIC_FREE_ACTION)
         !Kit(<target>,INQUISITOR)
         !Kit(<target>,UNDEADHUNTER)
         !HasItem("MORSWORD",<target>)
         !HasItemEquiped("RING09",<target>)
         !HasItemEquiped("SHLD25",<target>)
         !HasItemEquipedReal("NPSW01",<target>)
         !HasItemEquipedReal("SPER07",<target>)
         !HasItemEquipedReal("SW1H27",<target>)
         !HasItemEquipedReal("SW2H06",<target>)~
    OUTER_TEXT_SPRINT srcb_single_target_stats
        ~WIZARD_SPELL_TURNING WIZARD_SPELL_DEFLECTION WIZARD_SPELL_TRAP CLERIC_SHIELD_OF_THE_ARCHONS~

    ACTION_IF MOD_IS_INSTALLED ~rr/setup-rr.tp2~ 11 BEGIN
        OUTER_SET srcb_turning_number = IDS_OF_SYMBOL (~spell~ ~WIZARD_SPELL_TURNING~)
        ACTION_IF (srcb_turning_number < 0) BEGIN
            FAIL
                ~SRCB_RR_COMPAT: SPELL.IDS has no WIZARD_SPELL_TURNING, so Selina's Spell Turning self-recast block cannot be identified.~
        END
        LAF srcb_rr_resolve_replacement
            INT_VAR old_number = srcb_source_number
            STR_VAR symbol = ~WIZARD_DOMINATION~
            RET srcb_domination_spell = spell srcb_domination_symbols = symbols
        END
        LAF srcb_rr_require_filter_symbols
            STR_VAR ids = ~STATS~ symbols = EVAL ~%srcb_single_target_stats%~
        END
        // Selina, a sorcerer: Chaos becomes Domination, so her level-5 book
        // keeps four different spells.
        LAF srcb_rr_patch_cre_resource
            INT_VAR source_level = srcb_source_level
            STR_VAR
                resource_name = ~RR#SELI~
                source_spell = EVAL ~%srcb_source_spell%~
                chaos_spell = EVAL ~%srcb_chaos_spell%~
                replacement_spell = EVAL ~%srcb_domination_spell%~
        END
        LAF srcb_rr_patch_script_resource
            INT_VAR patch_selina_guard = 1 turning_number = srcb_turning_number
            STR_VAR
                resource_name = ~RR#SELI~
                old_symbols = EVAL ~%srcb_old_symbols%~
                chaos_symbols = EVAL ~%srcb_chaos_symbols%~
                replacement = ~WIZARD_DOMINATION~
                replacement_symbols = EVAL ~%srcb_domination_symbols%~
                filters = EVAL ~%srcb_domination_filters%~
        END
    END

    ACTION_IF MOD_IS_INSTALLED ~rr/setup-rr.tp2~ 12 BEGIN
        LAF srcb_rr_resolve_replacement
            INT_VAR old_number = srcb_source_number
            STR_VAR symbol = ~WIZARD_HOLD_MONSTER~
            RET srcb_hold_spell = spell srcb_hold_symbols = symbols
        END
        LAF srcb_rr_resolve_replacement
            INT_VAR old_number = srcb_source_number
            STR_VAR symbol = ~WIZARD_FEEBLEMIND~
            RET srcb_feeblemind_spell = spell srcb_feeblemind_symbols = symbols
        END
        LAF srcb_rr_require_filter_symbols
            STR_VAR ids = ~STATS~ symbols = EVAL ~CLERIC_FREE_ACTION %srcb_single_target_stats%~
        END
        LAF srcb_rr_require_filter_symbols
            STR_VAR ids = ~KIT~ symbols = ~INQUISITOR UNDEADHUNTER~
        END
        LAF srcb_rr_require_filter_symbols
            STR_VAR ids = ~GENERAL~ symbols = ~UNDEAD~
        END
        // Aran: Hold Monster, cast by his own script RR#ARAN2.
        LAF srcb_rr_patch_cre_resource
            INT_VAR source_level = srcb_source_level
            STR_VAR
                resource_name = ~RR#ARAN2~
                source_spell = EVAL ~%srcb_source_spell%~
                chaos_spell = EVAL ~%srcb_chaos_spell%~
                replacement_spell = EVAL ~%srcb_hold_spell%~
        END
        LAF srcb_rr_patch_script_resource
            STR_VAR
                resource_name = ~RR#ARAN2~
                old_symbols = EVAL ~%srcb_old_symbols%~
                chaos_symbols = EVAL ~%srcb_chaos_symbols%~
                replacement = ~WIZARD_HOLD_MONSTER~
                replacement_symbols = EVAL ~%srcb_hold_symbols%~
                filters = EVAL ~%srcb_hold_filters%~
        END
        // RR#SFL04: Feeblemind, cast by its script RR#STM01, which already
        // casts Feeblemind elsewhere.
        LAF srcb_rr_patch_cre_resource
            INT_VAR source_level = srcb_source_level
            STR_VAR
                resource_name = ~RR#SFL04~
                source_spell = EVAL ~%srcb_source_spell%~
                chaos_spell = EVAL ~%srcb_chaos_spell%~
                replacement_spell = EVAL ~%srcb_feeblemind_spell%~
        END
        LAF srcb_rr_patch_script_resource
            STR_VAR
                resource_name = ~RR#STM01~
                old_symbols = EVAL ~%srcb_old_symbols%~
                chaos_symbols = EVAL ~%srcb_chaos_symbols%~
                replacement = ~WIZARD_FEEBLEMIND~
                replacement_symbols = EVAL ~%srcb_feeblemind_symbols%~
                filters = EVAL ~%srcb_single_target_filters%~
        END
    END
END
