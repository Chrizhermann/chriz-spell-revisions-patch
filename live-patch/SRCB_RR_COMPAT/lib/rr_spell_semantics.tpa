// Compatibility transforms for Rogue Rebalancing v4.92 and Spell Revisions.
// This library is self-contained so SRCB_RR_COMPAT can be copied to a game
// without the rest of the fork.
//
// SR gives Chaos a level-7 wizard identity and turns its old level-5 slot into
// Waves of Fatigue. RR's mages were written for the old slot, so their
// spellbooks and scripts name Waves of Fatigue where RR meant Chaos. Records
// and references are recognized by the spell they name, never by how many of
// them one installation happened to contain.

// Regexp alternation of every SPELL.IDS symbol for one spell number. The script
// decompiler prints the last of several same-number symbols, so a reference can
// appear under any of them. IDS values may be decimal or hexadecimal (0x...),
// as the engine and WeiDU read both.
DEFINE_ACTION_FUNCTION srcb_rr_spell_symbols
    INT_VAR number = 0
    RET symbols
BEGIN
    OUTER_TEXT_SPRINT symbols ~~
    COPY_EXISTING ~spell.ids~ ~override~
        REPLACE_EVALUATE CASE_INSENSITIVE
            ~^[ %TAB%]*\(0[xX][0-9A-Fa-f]+\|[0-9]+\)[ %TAB%]+\([A-Za-z0-9_#]+\)~
        BEGIN
            PATCH_IF (MATCH1 = number) BEGIN
                PATCH_IF (~%symbols%~ STRING_EQUAL ~~) BEGIN
                    TEXT_SPRINT symbols ~%MATCH2%~
                END ELSE BEGIN
                    TEXT_SPRINT symbols ~%symbols%\|%MATCH2%~
                END
            END
        END ~%MATCH0%~
    BUT_ONLY
    ACTION_IF (~%symbols%~ STRING_EQUAL ~~) BEGIN
        FAIL ~SRCB_RR_COMPAT: SPELL.IDS has no readable symbol for spell %number%.~
    END
END


// Move every prepared copy of source_spell from the level-5 wizard row to the
// end of the level-7 wizard row, renamed, keeping its own flags (prepared or
// already cast). The table keeps its size: records between the two places
// shift by one, and the rows' first indexes follow them. Both rows' slot
// counters stay as they were, because RR's mages deliberately hold more
// prepared records than their counters.
DEFINE_PATCH_FUNCTION srcb_rr_move_prepared_copies
    INT_VAR
        copies = 0
        source_level = 4
        target_level = 6
    STR_VAR
        resource_name = ""
        source_spell = ""
        target_spell = ""
BEGIN
    READ_LONG 0x2a8 srcb_info_offset
    READ_LONG 0x2ac srcb_info_count
    READ_LONG 0x2b0 srcb_memorized_offset
    SET srcb_source_rows = 0
    SET srcb_target_rows = 0
    FOR (srcb_i = 0; srcb_i < srcb_info_count; ++srcb_i) BEGIN
        SET srcb_info = srcb_info_offset + srcb_i * 0x10
        PATCH_IF (SHORT_AT (srcb_info + 0x06) = 1) BEGIN
            PATCH_IF (SHORT_AT srcb_info = source_level) BEGIN
                SET srcb_source_rows += 1
                SET srcb_source_row = srcb_info
            END
            PATCH_IF (SHORT_AT srcb_info = target_level) BEGIN
                SET srcb_target_rows += 1
                SET srcb_target_row = srcb_info
            END
        END
    END
    PATCH_IF (srcb_source_rows != 1) OR (srcb_target_rows != 1) BEGIN
        PATCH_FAIL
            ~SRCB_RR_COMPAT: %resource_name%.CRE needs one level-5 and one level-7 wizard memorization row to move its %copies% prepared Chaos copies; it has %srcb_source_rows% and %srcb_target_rows%.~
    END

    // A record shared by two rows would change the other row too.
    FOR (srcb_i = 0; srcb_i < srcb_info_count; ++srcb_i) BEGIN
        READ_LONG (srcb_info_offset + srcb_i * 0x10 + 0x08) srcb_first
        READ_LONG (srcb_info_offset + srcb_i * 0x10 + 0x0c) srcb_count
        FOR (srcb_j = 0; srcb_j < srcb_i; ++srcb_j) BEGIN
            READ_LONG (srcb_info_offset + srcb_j * 0x10 + 0x08) srcb_other_first
            READ_LONG (srcb_info_offset + srcb_j * 0x10 + 0x0c) srcb_other_count
            PATCH_IF (srcb_count > 0) AND (srcb_other_count > 0)
                  AND (srcb_first < srcb_other_first + srcb_other_count)
                  AND (srcb_other_first < srcb_first + srcb_count) BEGIN
                PATCH_FAIL
                    ~SRCB_RR_COMPAT: %resource_name%.CRE memorization rows %srcb_j% and %srcb_i% share prepared records; moving Chaos copies would change another spell level.~
            END
        END
    END

    READ_LONG (srcb_source_row + 0x08) srcb_first
    READ_LONG (srcb_source_row + 0x0c) srcb_count
    SET srcb_in_row = 0
    FOR (srcb_j = 0; srcb_j < srcb_count; ++srcb_j) BEGIN
        READ_ASCII (srcb_memorized_offset + (srcb_first + srcb_j) * 0x0c) srcb_spell (8) NULL
        PATCH_IF (~%srcb_spell%~ STRING_EQUAL_CASE ~%source_spell%~) BEGIN
            SET srcb_in_row += 1
        END
    END
    PATCH_IF (srcb_in_row != copies) BEGIN
        PATCH_FAIL
            ~SRCB_RR_COMPAT: %resource_name%.CRE has %source_spell% prepared outside its level-5 wizard row (%srcb_in_row% of %copies% copies there); those copies cannot be attributed to RR's Chaos.~
    END

    // An empty row's first index means nothing to the engine and may point
    // between another row's records. Copies placed there would join that row
    // and push its last record out of it, so the level-7 row starts after it.
    READ_LONG (srcb_target_row + 0x08) srcb_target_first
    READ_LONG (srcb_target_row + 0x0c) srcb_target_count
    PATCH_IF (srcb_target_count = 0) BEGIN
        SET srcb_start = srcb_target_first
        FOR (srcb_i = 0; srcb_i < srcb_info_count; ++srcb_i) BEGIN
            READ_LONG (srcb_info_offset + srcb_i * 0x10 + 0x08) srcb_row_first
            READ_LONG (srcb_info_offset + srcb_i * 0x10 + 0x0c) srcb_row_count
            PATCH_IF (srcb_row_count > 0) AND (srcb_row_first < srcb_start)
                  AND (srcb_start < srcb_row_first + srcb_row_count) BEGIN
                SET srcb_start = srcb_row_first + srcb_row_count
            END
        END
        PATCH_IF (srcb_start != srcb_target_first) BEGIN
            WRITE_LONG (srcb_target_row + 0x08) srcb_start
        END
    END

    FOR (srcb_moved = 0; srcb_moved < copies; ++srcb_moved) BEGIN
        READ_LONG (srcb_source_row + 0x08) srcb_first
        READ_LONG (srcb_source_row + 0x0c) srcb_count
        SET srcb_from = 0 - 1
        FOR (srcb_j = 0; (srcb_j < srcb_count) AND (srcb_from < 0); ++srcb_j) BEGIN
            READ_ASCII (srcb_memorized_offset + (srcb_first + srcb_j) * 0x0c) srcb_spell (8) NULL
            PATCH_IF (~%srcb_spell%~ STRING_EQUAL_CASE ~%source_spell%~) BEGIN
                SET srcb_from = srcb_first + srcb_j
            END
        END
        READ_LONG (srcb_memorized_offset + srcb_from * 0x0c + 0x08) srcb_flags
        READ_LONG (srcb_target_row + 0x08) srcb_target_first
        READ_LONG (srcb_target_row + 0x0c) srcb_target_count
        SET srcb_to = srcb_target_first + srcb_target_count

        PATCH_IF (srcb_from < srcb_to) BEGIN
            // Level 7 lies after level 5: records in between move down one place.
            FOR (srcb_k = srcb_from; srcb_k < srcb_to - 1; ++srcb_k) BEGIN
                FOR (srcb_b = 0; srcb_b < 0x0c; srcb_b += 4) BEGIN
                    WRITE_LONG (srcb_memorized_offset + srcb_k * 0x0c + srcb_b)
                        (LONG_AT (srcb_memorized_offset + (srcb_k + 1) * 0x0c + srcb_b))
                END
            END
            SET srcb_slot = srcb_to - 1
            FOR (srcb_i = 0; srcb_i < srcb_info_count; ++srcb_i) BEGIN
                SET srcb_info = srcb_info_offset + srcb_i * 0x10
                READ_LONG (srcb_info + 0x08) srcb_row_first
                PATCH_IF (srcb_info = srcb_target_row)
                      OR ((srcb_row_first > srcb_from) AND (srcb_row_first < srcb_to)) BEGIN
                    WRITE_LONG (srcb_info + 0x08) (srcb_row_first - 1)
                END
            END
        END ELSE BEGIN
            // Level 7 lies before level 5: records in between move up one place.
            FOR (srcb_k = srcb_from; srcb_k > srcb_to; srcb_k -= 1) BEGIN
                FOR (srcb_b = 0; srcb_b < 0x0c; srcb_b += 4) BEGIN
                    WRITE_LONG (srcb_memorized_offset + srcb_k * 0x0c + srcb_b)
                        (LONG_AT (srcb_memorized_offset + (srcb_k - 1) * 0x0c + srcb_b))
                END
            END
            SET srcb_slot = srcb_to
            FOR (srcb_i = 0; srcb_i < srcb_info_count; ++srcb_i) BEGIN
                SET srcb_info = srcb_info_offset + srcb_i * 0x10
                READ_LONG (srcb_info + 0x08) srcb_row_first
                PATCH_IF (srcb_info != srcb_target_row)
                      AND (srcb_row_first >= srcb_to) AND (srcb_row_first <= srcb_from) BEGIN
                    WRITE_LONG (srcb_info + 0x08) (srcb_row_first + 1)
                END
            END
        END
        WRITE_ASCIIE (srcb_memorized_offset + srcb_slot * 0x0c) ~%target_spell%~ #8
        WRITE_LONG (srcb_memorized_offset + srcb_slot * 0x0c + 0x08) srcb_flags
        WRITE_LONG (srcb_source_row + 0x0c) (LONG_AT (srcb_source_row + 0x0c) - 1)
        WRITE_LONG (srcb_target_row + 0x0c) (LONG_AT (srcb_target_row + 0x0c) + 1)
    END
END


DEFINE_PATCH_FUNCTION srcb_rr_migrate_chaos_spellbook
    INT_VAR
        source_level = 4
        target_level = 6
    STR_VAR
        resource_name = ""
        source_spell = ""
        target_spell = ""
BEGIN
    SET srcb_valid_cre = 0
    PATCH_IF (SOURCE_SIZE > 0x2d3) BEGIN
        READ_ASCII 0 srcb_signature (8)
        READ_BYTE 0x33 srcb_effect_version
        READ_LONG 0x2a0 srcb_known_offset
        READ_LONG 0x2a4 srcb_known_count
        READ_LONG 0x2a8 srcb_info_offset
        READ_LONG 0x2ac srcb_info_count
        READ_LONG 0x2b0 srcb_memorized_offset
        READ_LONG 0x2b4 srcb_memorized_count
        READ_LONG 0x2b8 srcb_slots_offset
        READ_LONG 0x2bc srcb_items_offset
        READ_LONG 0x2c0 srcb_items_count
        READ_LONG 0x2c4 srcb_effects_offset
        READ_LONG 0x2c8 srcb_effects_count
        SET srcb_effect_stride = 0
        PATCH_IF (srcb_effect_version = 0) BEGIN
            SET srcb_effect_stride = 0x30
        END ELSE PATCH_IF (srcb_effect_version = 1) BEGIN
            SET srcb_effect_stride = 0x108
        END
        PATCH_IF (~%srcb_signature%~ STRING_EQUAL_CASE ~CRE V1.0~)
              AND (srcb_effect_stride > 0)
              AND (srcb_known_offset >= 0x2d4)
              AND (srcb_known_offset + srcb_known_count * 0x0c <= SOURCE_SIZE)
              AND (srcb_info_offset >= 0x2d4)
              AND (srcb_info_offset + srcb_info_count * 0x10 <= SOURCE_SIZE)
              AND (srcb_memorized_offset >= 0x2d4)
              AND (srcb_memorized_offset + srcb_memorized_count * 0x0c <= SOURCE_SIZE)
              AND (srcb_slots_offset >= 0x2d4)
              AND (srcb_slots_offset + 0x50 <= SOURCE_SIZE)
              AND (srcb_items_offset >= 0x2d4)
              AND (srcb_items_offset + srcb_items_count * 0x14 <= SOURCE_SIZE)
              AND (srcb_effects_offset >= 0x2d4)
              AND (srcb_effects_offset + srcb_effects_count * srcb_effect_stride <= SOURCE_SIZE) BEGIN
            SET srcb_valid_cre = 1
            FOR (srcb_i = 0; (srcb_i < srcb_info_count) AND (srcb_valid_cre = 1); ++srcb_i) BEGIN
                SET srcb_info = srcb_info_offset + srcb_i * 0x10
                READ_LONG (srcb_info + 0x08) srcb_first
                READ_LONG (srcb_info + 0x0c) srcb_count
                PATCH_IF (srcb_first + srcb_count > srcb_memorized_count) BEGIN
                    SET srcb_valid_cre = 0
                END
            END
        END
    END
    PATCH_IF (srcb_valid_cre = 0) BEGIN
        PATCH_FAIL ~SRCB_RR_COMPAT: %resource_name%.CRE has an invalid or unsupported CRE V1.0 structure.~
    END

    SET srcb_source_known = 0
    SET srcb_source_known_book = 0
    SET srcb_target_known = 0
    FOR (srcb_i = 0; srcb_i < srcb_known_count; ++srcb_i) BEGIN
        SET srcb_entry = srcb_known_offset + srcb_i * 0x0c
        READ_ASCII srcb_entry srcb_spell (8) NULL
        PATCH_IF (~%srcb_spell%~ STRING_EQUAL_CASE ~%source_spell%~) BEGIN
            SET srcb_source_known += 1
            PATCH_IF (SHORT_AT (srcb_entry + 0x08) = source_level) AND (SHORT_AT (srcb_entry + 0x0a) = 1) BEGIN
                SET srcb_source_known_book += 1
            END
        END
        PATCH_IF (~%srcb_spell%~ STRING_EQUAL_CASE ~%target_spell%~) BEGIN
            SET srcb_target_known += 1
        END
    END
    SET srcb_source_prepared = 0
    SET srcb_target_prepared = 0
    FOR (srcb_i = 0; srcb_i < srcb_memorized_count; ++srcb_i) BEGIN
        READ_ASCII (srcb_memorized_offset + srcb_i * 0x0c) srcb_spell (8) NULL
        PATCH_IF (~%srcb_spell%~ STRING_EQUAL_CASE ~%source_spell%~) BEGIN
            SET srcb_source_prepared += 1
        END
        PATCH_IF (~%srcb_spell%~ STRING_EQUAL_CASE ~%target_spell%~) BEGIN
            SET srcb_target_prepared += 1
        END
    END
    SET srcb_has_source = (srcb_source_known + srcb_source_prepared > 0)
    SET srcb_has_target = (srcb_target_known + srcb_target_prepared > 0)

    // Old-slot records alongside Chaos could be RR's broken Chaos or a later
    // mod's intended Waves of Fatigue.
    PATCH_IF srcb_has_source AND srcb_has_target BEGIN
        PATCH_FAIL
            ~SRCB_RR_COMPAT: %resource_name%.CRE names both %source_spell% (RR's Chaos slot, now Waves of Fatigue) and %target_spell% (Chaos): known %srcb_source_known% and %srcb_target_known%, prepared %srcb_source_prepared% and %srcb_target_prepared%. Which %source_spell% records RR meant as Chaos is ambiguous.~
    END
    PATCH_IF (srcb_has_source = 0) AND (srcb_has_target = 0) BEGIN
        PATCH_WARN
            ~SRCB_RR_COMPAT: %resource_name%.CRE names neither %source_spell% nor %target_spell%; its spellbook is left unchanged.~
    END
    PATCH_IF srcb_has_source AND (srcb_has_target = 0) BEGIN
        PATCH_IF (srcb_source_known_book != srcb_source_known) BEGIN
            PATCH_FAIL
                ~SRCB_RR_COMPAT: %resource_name%.CRE knows %source_spell% outside its level-5 wizard book (%srcb_source_known_book% of %srcb_source_known% known records there); those records cannot be attributed to RR's Chaos.~
        END
        PATCH_IF (srcb_source_prepared > 0) BEGIN
            LPF srcb_rr_move_prepared_copies
                INT_VAR
                    copies = srcb_source_prepared
                    source_level = source_level
                    target_level = target_level
                STR_VAR
                    resource_name = EVAL ~%resource_name%~
                    source_spell = EVAL ~%source_spell%~
                    target_spell = EVAL ~%target_spell%~
            END
        END
        // Known records are renamed where they stand.
        FOR (srcb_i = 0; srcb_i < srcb_known_count; ++srcb_i) BEGIN
            SET srcb_entry = srcb_known_offset + srcb_i * 0x0c
            READ_ASCII srcb_entry srcb_spell (8) NULL
            PATCH_IF (~%srcb_spell%~ STRING_EQUAL_CASE ~%source_spell%~) BEGIN
                WRITE_ASCIIE srcb_entry ~%target_spell%~ #8
                WRITE_SHORT (srcb_entry + 0x08) target_level
            END
        END
    END
END


// RR wrote these scripts for Chaos's old slot: RR v4.92 names it only by the
// WIZARD_CHAOS symbol. A script that still names the old slot therefore means
// Chaos by it. A script naming both slots could hold a later mod's intended
// Waves of Fatigue, so it is not guessed at.
DEFINE_PATCH_FUNCTION srcb_rr_normalize_chaos_script
    STR_VAR
        resource_name = ""
        source_symbols = ""
        target_symbols = ""
BEGIN
    COUNT_REGEXP_INSTANCES CASE_SENSITIVE ~[(,]\(%source_symbols%\)[),]~ srcb_old_count
    COUNT_REGEXP_INSTANCES CASE_SENSITIVE ~[(,]\(%target_symbols%\)[),]~ srcb_final_count
    PATCH_IF (srcb_old_count > 0) AND (srcb_final_count > 0) BEGIN
        PATCH_FAIL
            ~SRCB_RR_COMPAT: %resource_name%.BCS names both Waves of Fatigue (%srcb_old_count% references) and Chaos (%srcb_final_count%); which Waves of Fatigue references RR meant as Chaos is ambiguous.~
    END ELSE PATCH_IF (srcb_old_count > 0) BEGIN
        // Adjacent references share a delimiter, so repeat until none is left.
        WHILE (srcb_old_count > 0) BEGIN
            REPLACE_TEXTUALLY CASE_SENSITIVE
                ~\([(,]\)\(%source_symbols%\)\([),]\)~
                ~\1WIZARD_CHAOS\3~
            COUNT_REGEXP_INSTANCES CASE_SENSITIVE ~[(,]\(%source_symbols%\)[),]~ srcb_old_count
        END
    END ELSE PATCH_IF (srcb_final_count = 0) BEGIN
        PATCH_WARN
            ~SRCB_RR_COMPAT: %resource_name%.BCS names neither Waves of Fatigue nor Chaos; it is left unchanged.~
    END
END


// Whether a decompiled response list casts spell `number` on Myself.
DEFINE_PATCH_FUNCTION srcb_rr_casts_on_self
    INT_VAR number = 0
    STR_VAR actions = ""
    RET hit
BEGIN
    SET hit = 0
    INNER_PATCH ~%actions%~ BEGIN
        REPLACE_EVALUATE CASE_SENSITIVE
            ~\(Spell\|SpellNoDec\|ForceSpell\|ReallyForceSpell\)(Myself,\([A-Za-z0-9_#]+\))~
        BEGIN
            PATCH_IF (IS_AN_INT MATCH2) BEGIN
                PATCH_IF (MATCH2 = number) BEGIN
                    SET hit = 1
                END
            END ELSE PATCH_IF (IDS_OF_SYMBOL (~spell~ ~%MATCH2%~) = number) BEGIN
                SET hit = 1
            END
        END ~%MATCH0%~
    END
END


// Selina's self-recast block casts the Spell Turning identifier on herself and
// skips the cast while her Spell Turning stat is up. SR's spell behind that
// identifier raises the Spell Deflection stat instead, so her guard must check
// that. Only guards in blocks casting that identifier on Myself change; her
// Spell Turning checks on enemies, or before other spells, keep their meaning.
DEFINE_PATCH_FUNCTION srcb_rr_fix_selina_deflection_guard
    INT_VAR turning_number = 0
    STR_VAR resource_name = ""
BEGIN
    SET srcb_corrected = 0
    SET srcb_already = 0
    TEXT_SPRINT srcb_new_guard ~!CheckStatGT(Myself,0,WIZARD_SPELL_DEFLECTION)~
    PATCH_FOR_EACH srcb_stat IN ~WIZARD_SPELL_DEFLECTION~ ~WIZARD_SPELL_TURNING~ BEGIN
        TEXT_SPRINT srcb_guard ~!CheckStatGT(Myself,0,%srcb_stat%)~
        SET srcb_at = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%srcb_guard%~)
        WHILE (srcb_at >= 0) BEGIN
            SET srcb_then = INDEX_BUFFER (CASE_SENSITIVE ~^THEN~ srcb_at)
            SET srcb_end = INDEX_BUFFER (CASE_SENSITIVE ~^END~ srcb_at)
            PATCH_IF (srcb_then < 0) OR (srcb_end < srcb_then) BEGIN
                PATCH_FAIL ~SRCB_RR_COMPAT: %resource_name%.BCS decompiled to an unrecognized block layout.~
            END
            READ_ASCII srcb_then srcb_actions (srcb_end - srcb_then)
            LPF srcb_rr_casts_on_self
                INT_VAR number = turning_number
                STR_VAR actions = EVAL ~%srcb_actions%~
                RET srcb_self_cast = hit
            END
            PATCH_IF srcb_self_cast BEGIN
                PATCH_IF (~%srcb_stat%~ STRING_EQUAL ~WIZARD_SPELL_TURNING~) BEGIN
                    DELETE_BYTES srcb_at (STRING_LENGTH ~%srcb_guard%~)
                    INSERT_BYTES srcb_at (STRING_LENGTH ~%srcb_new_guard%~)
                    WRITE_ASCIIE srcb_at ~%srcb_new_guard%~
                    SET srcb_corrected += 1
                END ELSE BEGIN
                    SET srcb_already += 1
                END
            END
            SET srcb_at = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%srcb_guard%~ (srcb_at + 1))
        END
    END
    PATCH_IF (srcb_corrected + srcb_already = 0) BEGIN
        PATCH_WARN
            ~SRCB_RR_COMPAT: %resource_name%.BCS has no self-recast of Spell Turning guarded by her Turning or Deflection stat; nothing to correct.~
    END
END


DEFINE_ACTION_FUNCTION srcb_rr_patch_cre_resource
    INT_VAR
        source_level = 4
        target_level = 6
    STR_VAR
        resource_name = ""
        source_spell = ""
        target_spell = ""
BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%resource_name%.cre~ BEGIN
        COPY_EXISTING ~%resource_name%.cre~ ~override~
            LPF srcb_rr_migrate_chaos_spellbook
                INT_VAR
                    source_level = source_level
                    target_level = target_level
                STR_VAR
                    resource_name = EVAL ~%resource_name%~
                    source_spell = EVAL ~%source_spell%~
                    target_spell = EVAL ~%target_spell%~
            END
        BUT_ONLY
    END ELSE BEGIN
        WARN ~SRCB_RR_COMPAT: %resource_name%.CRE is not in the game; there is no spellbook to migrate.~
    END
END


DEFINE_ACTION_FUNCTION srcb_rr_patch_script_resource
    INT_VAR
        patch_selina_guard = 0
        turning_number = 0
    STR_VAR
        resource_name = ""
        source_symbols = ""
        target_symbols = ""
BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%resource_name%.bcs~ BEGIN
        COPY_EXISTING ~%resource_name%.bcs~ ~override~
            DECOMPILE_AND_PATCH BEGIN
                LPF srcb_rr_normalize_chaos_script
                    STR_VAR
                        resource_name = EVAL ~%resource_name%~
                        source_symbols = EVAL ~%source_symbols%~
                        target_symbols = EVAL ~%target_symbols%~
                END
                PATCH_IF (patch_selina_guard = 1) BEGIN
                    LPF srcb_rr_fix_selina_deflection_guard
                        INT_VAR turning_number = turning_number
                        STR_VAR resource_name = EVAL ~%resource_name%~
                    END
                END
            END
        BUT_ONLY
    END ELSE BEGIN
        WARN ~SRCB_RR_COMPAT: %resource_name%.BCS is not in the game; there is no script to migrate.~
    END
END


DEFINE_ACTION_FUNCTION srcb_rr_require_wizard_spell
    INT_VAR expected_level = 1
    STR_VAR resource_name = ""
BEGIN
    ACTION_IF NOT FILE_EXISTS_IN_GAME ~%resource_name%.spl~ BEGIN
        FAIL ~SRCB_RR_COMPAT: required spell %resource_name%.SPL does not exist.~
    END
    COPY_EXISTING ~%resource_name%.spl~ ~override~
        PATCH_IF (SOURCE_SIZE < 0x38) BEGIN
            PATCH_FAIL ~SRCB_RR_COMPAT: %resource_name%.SPL is too small to be a valid spell.~
        END
        READ_ASCII 0 srcb_spell_signature (8)
        READ_SHORT 0x1c srcb_spell_type
        READ_LONG 0x34 srcb_spell_level
        PATCH_IF NOT (~%srcb_spell_signature%~ STRING_EQUAL_CASE ~SPL V1  ~)
              OR (srcb_spell_type != 1)
              OR (srcb_spell_level != expected_level) BEGIN
            PATCH_FAIL
                ~SRCB_RR_COMPAT: %resource_name%.SPL is not the expected level-%expected_level% wizard spell.~
        END
    BUT_ONLY
END


DEFINE_ACTION_FUNCTION srcb_rr_apply_spell_semantics
BEGIN
    OUTER_SET srcb_source_number = IDS_OF_SYMBOL (~spell~ ~WIZARD_WAVES_OF_FATIGUE~)
    OUTER_SET srcb_target_number = IDS_OF_SYMBOL (~spell~ ~WIZARD_CHAOS~)
    OUTER_SET srcb_sphere_number = IDS_OF_SYMBOL (~spell~ ~WIZARD_SPHERE_OF_CHAOS~)
    // A Sphere of Chaos symbol naming another spell would leave two candidates
    // for Chaos.
    ACTION_IF (srcb_source_number < 2001)
          OR (srcb_source_number > 2999)
          OR (srcb_target_number < 2001)
          OR (srcb_target_number > 2999)
          OR (srcb_source_number = srcb_target_number)
          OR ((srcb_sphere_number >= 0) AND (srcb_sphere_number != srcb_target_number)) BEGIN
        FAIL
            ~SRCB_RR_COMPAT: final SPELL.IDS must map WIZARD_WAVES_OF_FATIGUE and WIZARD_CHAOS to two different wizard spells, and WIZARD_SPHERE_OF_CHAOS, if present, to the same spell as WIZARD_CHAOS.~
    END

    LAF RES_NUM_OF_SPELL_NAME
        STR_VAR spell_name = ~WIZARD_WAVES_OF_FATIGUE~
        RET srcb_source_spell = spell_res
    END
    LAF RES_NUM_OF_SPELL_NAME
        STR_VAR spell_name = ~WIZARD_CHAOS~
        RET srcb_target_spell = spell_res
    END
    OUTER_TEXT_SPRINT srcb_source_spell ~%srcb_source_spell%~
    OUTER_TEXT_SPRINT srcb_target_spell ~%srcb_target_spell%~
    ACTION_TO_UPPER srcb_source_spell
    ACTION_TO_UPPER srcb_target_spell
    OUTER_SET srcb_source_level = ((srcb_source_number - 2000) / 100) - 1
    OUTER_SET srcb_target_level = ((srcb_target_number - 2000) / 100) - 1
    ACTION_IF (srcb_source_level != 4) OR (srcb_target_level != 6) BEGIN
        FAIL
            ~SRCB_RR_COMPAT: expected Waves of Fatigue at wizard level 5 and Chaos at wizard level 7 in final SPELL.IDS.~
    END
    LAF srcb_rr_require_wizard_spell
        INT_VAR expected_level = 5
        STR_VAR resource_name = EVAL ~%srcb_source_spell%~
    END
    LAF srcb_rr_require_wizard_spell
        INT_VAR expected_level = 7
        STR_VAR resource_name = EVAL ~%srcb_target_spell%~
    END
    LAF srcb_rr_spell_symbols
        INT_VAR number = srcb_source_number
        RET srcb_source_symbols = symbols
    END
    LAF srcb_rr_spell_symbols
        INT_VAR number = srcb_target_number
        RET srcb_target_symbols = symbols
    END

    ACTION_IF MOD_IS_INSTALLED ~rr/setup-rr.tp2~ 11 BEGIN
        OUTER_SET srcb_turning_number = IDS_OF_SYMBOL (~spell~ ~WIZARD_SPELL_TURNING~)
        ACTION_IF (srcb_turning_number < 0) BEGIN
            FAIL
                ~SRCB_RR_COMPAT: SPELL.IDS has no WIZARD_SPELL_TURNING, so Selina's Spell Turning self-recast block cannot be identified.~
        END
        ACTION_FOR_EACH srcb_creature IN ~RR#SELI~ ~RR#ZAER~ BEGIN
            LAF srcb_rr_patch_cre_resource
                INT_VAR source_level = srcb_source_level target_level = srcb_target_level
                STR_VAR
                    resource_name = EVAL ~%srcb_creature%~
                    source_spell = EVAL ~%srcb_source_spell%~
                    target_spell = EVAL ~%srcb_target_spell%~
            END
        END
        LAF srcb_rr_patch_script_resource
            INT_VAR patch_selina_guard = 1 turning_number = srcb_turning_number
            STR_VAR
                resource_name = ~RR#SELI~
                source_symbols = EVAL ~%srcb_source_symbols%~
                target_symbols = EVAL ~%srcb_target_symbols%~
        END
    END

    ACTION_IF MOD_IS_INSTALLED ~rr/setup-rr.tp2~ 12 BEGIN
        ACTION_FOR_EACH srcb_creature IN ~RR#ARAN2~ ~RR#SAW09~ ~RR#SFL04~ BEGIN
            LAF srcb_rr_patch_cre_resource
                INT_VAR source_level = srcb_source_level target_level = srcb_target_level
                STR_VAR
                    resource_name = EVAL ~%srcb_creature%~
                    source_spell = EVAL ~%srcb_source_spell%~
                    target_spell = EVAL ~%srcb_target_spell%~
            END
        END
        ACTION_FOR_EACH srcb_script IN ~RR#ARAN2~ ~RR#STM01~ BEGIN
            LAF srcb_rr_patch_script_resource
                STR_VAR
                    resource_name = EVAL ~%srcb_script%~
                    source_symbols = EVAL ~%srcb_source_symbols%~
                    target_symbols = EVAL ~%srcb_target_symbols%~
            END
        END
    END
END
