  END
  ACTION_IF (sr_config_game_known = 0) BEGIN
    OUTER_SPRINT sr_config_errors ~%sr_config_errors%- unknown game '%sr_config_game%'%LNL%~
    OUTER_SET sr_config_error_count += 1
  END
  // arcane.level1.grease
  OUTER_SET sr_feature_000001 = sr_wizard_grease
  ACTION_IF (sr_feature_000001 = (0 - 1)) BEGIN
    OUTER_SET sr_feature_000001 = sr_arcane_level_1_default
  END
  ACTION_IF (sr_feature_000001 = (0 - 1)) BEGIN
    OUTER_SET sr_feature_000001 = sr_arcane_default
  END
  ACTION_IF (sr_feature_000001 = (0 - 1)) BEGIN
    OUTER_SET sr_feature_000001 = sr_default
  END
  ACTION_IF NOT ((~%sr_config_game%~ STRING_EQUAL_CASE ~soa~) OR (~%sr_config_game%~ STRING_EQUAL_CASE ~tob~) OR (~%sr_config_game%~ STRING_EQUAL_CASE ~bgee~) OR (~%sr_config_game%~ STRING_EQUAL_CASE ~bg2ee~) OR (~%sr_config_game%~ STRING_EQUAL_CASE ~eet~) OR (~%sr_config_game%~ STRING_EQUAL_CASE ~iwdee~) OR (~%sr_config_game%~ STRING_EQUAL_CASE ~tutu~) OR (~%sr_config_game%~ STRING_EQUAL_CASE ~tutu_totsc~) OR (~%sr_config_game%~ STRING_EQUAL_CASE ~bgt~)) BEGIN
    ACTION_IF (sr_wizard_grease = 1) BEGIN
