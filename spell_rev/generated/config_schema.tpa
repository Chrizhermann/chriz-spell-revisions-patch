// Generated from spell_rev/catalog/changes.json. Do not edit.
// The config remains inert text until every significant line is recognized.
DEFINE_ACTION_MACRO sr_config_load_validate BEGIN
  ACTION_IF NOT FILE_EXISTS ~%sr_config_path%~ BEGIN
    FAIL ~Spell Revisions configuration file is missing: %sr_config_path%~
  END
  OUTER_SET sr_config_error_count = 0
  OUTER_SPRINT sr_config_errors ~~
  COPY ~%sr_config_path%~ ~~
    COUNT_REGEXP_INSTANCES CASE_SENSITIVE "^[ %TAB%]*[^ %TAB%%WNL%%MNL%%LNL%]" sr_config_nonblank_lines
    COUNT_REGEXP_INSTANCES CASE_SENSITIVE "^[ %TAB%]*//" sr_config_comment_lines
    SET sr_config_significant_lines = sr_config_nonblank_lines - sr_config_comment_lines
    SET sr_config_recognized_lines = 0
    // Required statement: install_tobex
    COUNT_REGEXP_INSTANCES CASE_INSENSITIVE "^[ %TAB%]*install_tobex[ %TAB%]*=" sr_config_broad_000001
    COUNT_REGEXP_INSTANCES CASE_INSENSITIVE "^[ %TAB%]*install_tobex[ %TAB%]*=[ %TAB%]*1[ %TAB%]*\(//[^%WNL%%MNL%%LNL%]*\)?\(%WNL%\|%MNL%\|%LNL%\|$\)" sr_config_exact_000001
    SET sr_config_recognized_lines += sr_config_exact_000001
    PATCH_IF (sr_config_broad_000001 = 0) BEGIN
      SPRINT sr_config_errors ~%sr_config_errors%- missing setting install_tobex%LNL%~
      SET sr_config_error_count += 1
    END ELSE PATCH_IF (sr_config_broad_000001 > 1) BEGIN
      SPRINT sr_config_errors ~%sr_config_errors%- duplicate setting install_tobex%LNL%~
      SET sr_config_error_count += 1
    END ELSE PATCH_IF (sr_config_exact_000001 != 1) BEGIN
      SPRINT sr_config_errors ~%sr_config_errors%- install_tobex: expected exactly 1%LNL%~
      SET sr_config_error_count += 1
    END
    // Required statement: sr_config_schema
    COUNT_REGEXP_INSTANCES CASE_INSENSITIVE "^[ %TAB%]*sr_config_schema[ %TAB%]*=" sr_config_broad_000002
    COUNT_REGEXP_INSTANCES CASE_INSENSITIVE "^[ %TAB%]*sr_config_schema[ %TAB%]*=[ %TAB%]*1[ %TAB%]*\(//[^%WNL%%MNL%%LNL%]*\)?\(%WNL%\|%MNL%\|%LNL%\|$\)" sr_config_exact_000002
    SET sr_config_recognized_lines += sr_config_exact_000002
    PATCH_IF (sr_config_broad_000002 = 0) BEGIN
      SPRINT sr_config_errors ~%sr_config_errors%- missing setting sr_config_schema%LNL%~
      SET sr_config_error_count += 1
    END ELSE PATCH_IF (sr_config_broad_000002 > 1) BEGIN
      SPRINT sr_config_errors ~%sr_config_errors%- duplicate setting sr_config_schema%LNL%~
      SET sr_config_error_count += 1
    END ELSE PATCH_IF (sr_config_exact_000002 != 1) BEGIN
      SPRINT sr_config_errors ~%sr_config_errors%- stale or malformed sr_config_schema%LNL%~
      SET sr_config_error_count += 1
    END
    // Required statement: sr_catalog_fingerprint
    COUNT_REGEXP_INSTANCES CASE_INSENSITIVE "^[ %TAB%]*SPRINT[ %TAB%]+sr_catalog_fingerprint[ %TAB%]+" sr_config_broad_000003
    COUNT_REGEXP_INSTANCES CASE_SENSITIVE "^[ %TAB%]*SPRINT[ %TAB%]+sr_catalog_fingerprint[ %TAB%]+~cedd261ebcaba138b36372f05fa6f339cd4483376cba500846e4ddf7de376c2d~[ %TAB%]*\(//[^%WNL%%MNL%%LNL%]*\)?\(%WNL%\|%MNL%\|%LNL%\|$\)" sr_config_exact_000003
    SET sr_config_recognized_lines += sr_config_exact_000003
    PATCH_IF (sr_config_broad_000003 = 0) BEGIN
      SPRINT sr_config_errors ~%sr_config_errors%- missing setting sr_catalog_fingerprint%LNL%~
      SET sr_config_error_count += 1
    END ELSE PATCH_IF (sr_config_broad_000003 > 1) BEGIN
      SPRINT sr_config_errors ~%sr_config_errors%- duplicate setting sr_catalog_fingerprint%LNL%~
