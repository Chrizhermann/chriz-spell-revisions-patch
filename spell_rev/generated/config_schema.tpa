    END ELSE PATCH_IF (sr_config_exact_000003 != 1) BEGIN
      SPRINT sr_config_errors ~%sr_config_errors%- stale or malformed sr_catalog_fingerprint%LNL%~
      SET sr_config_error_count += 1
    END
    // Required statement: sr_default
    COUNT_REGEXP_INSTANCES CASE_INSENSITIVE "^[ %TAB%]*sr_default[ %TAB%]*=" sr_config_broad_000004
    COUNT_REGEXP_INSTANCES CASE_INSENSITIVE "^[ %TAB%]*sr_default[ %TAB%]*=[ %TAB%]*\(0\|1\)[ %TAB%]*\(//[^%WNL%%MNL%%LNL%]*\)?\(%WNL%\|%MNL%\|%LNL%\|$\)" sr_config_exact_000004
    SET sr_config_recognized_lines += sr_config_exact_000004
    PATCH_IF (sr_config_broad_000004 = 0) BEGIN
      SPRINT sr_config_errors ~%sr_config_errors%- missing setting sr_default%LNL%~
