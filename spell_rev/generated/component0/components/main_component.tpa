  SAY NAME1 @403    SAY UNIDENTIFIED_DESC @404
COPY ~spell_rev\spwi1##\scrl67.itm~     ~override~
  SAY NAME2 @403    SAY IDENTIFIED_DESC   @404

END
// SR_CONFIG_GUARD_END change:arcane.level1.armor
// SR_CONFIG_GUARD_BEGIN change:arcane.level1.burning_hands
ACTION_IF (sr_feature_000003 = 1) BEGIN
ADD_PROJECTILE ~spell_rev\projectles\dvburnhd.pro~
COPY ~spell_rev\spwi1##\spwi103.spl~     ~override~  // Burning Hands
  SAY NAME1 @405    SAY UNIDENTIFIED_DESC @406
  SET "loop" = 5
  WHILE (%loop% > 0) BEGIN
    WRITE_SHORT (0x98 + 0x28 * (%loop% - 1) ) %dvburnhd%
    SET "loop" = %loop% - 1
  END
COPY ~spell_rev\spwi1##\scrl68.itm~     ~override~
  SAY NAME2 @405    SAY IDENTIFIED_DESC   @406

END
// SR_CONFIG_GUARD_END change:arcane.level1.burning_hands
// SR_CONFIG_GUARD_BEGIN change:arcane.level1.charm_person
ACTION_IF (sr_feature_000004 = 1) BEGIN
COPY ~spell_rev\spwi1##\spwi104.spl~     ~override~  // Charm Person
  SAY NAME1 @407    SAY UNIDENTIFIED_DESC @408
COPY ~spell_rev\spwi1##\scrl69.itm~     ~override~
  SAY NAME2 @407    SAY IDENTIFIED_DESC   @408

// Auxiliary resources. COPY's under guards for debugging.
// Cast aux spell eff.
ACTION_IF NOT FILE_EXISTS_IN_GAME "spwi104.eff" BEGIN
    COPY ~spell_rev/spwi1##/spwi104.eff~ ~override~
END ELSE BEGIN
    WARN "File 'spwi104.eff' already exists in-game. No copy made."
END

// Aux spell.
ACTION_IF NOT FILE_EXISTS_IN_GAME "dvhchrm.spl" BEGIN
    COPY ~spell_rev/spwi1##/dvhchrm.spl~ ~override~
END ELSE BEGIN
    WARN "File 'dvhchrm.spl' already exists in-game. No copy made."
END

// Protection from spell eff for racial immunities.
ACTION_IF NOT FILE_EXISTS_IN_GAME "dvhchrm.eff" BEGIN
    COPY ~spell_rev/spwi1##/dvhchrm.eff~ ~override~
END ELSE BEGIN
    WARN "File 'dvhchrm.eff' already exists in-game. No copy made."
END

END
