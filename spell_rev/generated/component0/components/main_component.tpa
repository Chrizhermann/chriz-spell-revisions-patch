  SAY NAME1 @735    SAY UNIDENTIFIED_DESC @736
COPY ~spell_rev\spwi7##\scrl8l.itm~     ~override~
  SAY NAME2 @735    SAY IDENTIFIED_DESC   @736
COPY ~spell_rev\spwi7##\spwi710d.spl~     ~override~
  SAY NAME1 @735

END
