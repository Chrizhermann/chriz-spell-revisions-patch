COPY ~spell_rev\spwi5##\spwi522.spl~     ~override~  // Spell Deflection (replaces Minor Spell Turning)
  SAY NAME1 @653    SAY UNIDENTIFIED_DESC @654
LAF ds_altered_spell INT_VAR old_clone=200 new_clone=~-1~ STR_VAR file=~spwi522.spl~ END
APPEND_OUTER ~spell_rev/lib/ds_sr_extra.2da~ ~SPWI522.SPL    233     1     116   201    n     A~
COPY ~spell_rev\spwi5##\scrl7d.itm~     ~override~
  SAY NAME2 @653    SAY IDENTIFIED_DESC   @654
COPY ~spell_rev\spwi5##\spwi522a.bam~    ~override~
