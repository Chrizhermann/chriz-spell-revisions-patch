// Auxiliary resources. COPY's under guards for debugging.
// Aux spell.
END
// SR_CONFIG_GUARD_END change:divine.chant
// SR_CONFIG_GUARD_BEGIN change:divine.charm_person_or_animal
ACTION_IF (sr_feature_000203 = 1) BEGIN
ACTION_IF NOT FILE_EXISTS_IN_GAME "dvachrm.spl" BEGIN
  COPY ~spell_rev/spwi1##/dvhchrm.spl~ ~override/dvachrm.spl~
      //Patch duration 30 -> 60.
      LPF ALTER_SPELL_EFFECT INT_VAR
          duration_high = 60
      END
      //Patch in resource for racial immunity. Should already be in, but just in case.
      LPF ALTER_EFFECT INT_VAR
          match_opcode = 177            //Use Eff.
      STR_VAR
          resource = "dvachrm"
      END
      //Add charm animal.
      LPF CLONE_EFFECT INT_VAR
          match_opcode = 5              //Charm.
          match_parameter1 = 1          //Humanoid.
          parameter1 = 2                //Animal.
      STR_VAR
          insert = "below"
      END
END ELSE BEGIN
  WARN "File 'dvachrm.spl' already exists in-game. No copy made."
END

// Protection from spell eff for racial immunities.
ACTION_IF NOT FILE_EXISTS_IN_GAME "dvachrm.eff" BEGIN
    COPY ~spell_rev/spwi1##/dvhchrm.eff~ ~override/dvachrm.eff~
        //Patch-in spell to be protected from.
        WRITE_ASCII 0x30 "dvachrm" #8
END ELSE BEGIN
    WARN "File 'dvachrm.eff' already exists in-game. No copy made."
END

// Cast aux spell eff.
ACTION_IF NOT FILE_EXISTS_IN_GAME "sppr204.eff" BEGIN
    COPY ~spell_rev/spwi1##/spwi104.eff~ ~override/sppr204.eff~
        //Patch-in spell to cast.
        WRITE_ASCII 0x30 "dvachrm" #8
END ELSE BEGIN
    WARN "File 'sppr204.eff' already exists in-game. No copy made."
END

COPY ~spell_rev\sppr2##\sppr204.spl~ ~override~  // Charm Person or Mammal
    SAY NAME1 @37
    SAY UNIDENTIFIED_DESC @38
    //Patch-in spell to cast. Should already be in, but just in case.
    LPF ALTER_EFFECT INT_VAR
        match_opcode = 177              //Use Eff.
    STR_VAR
        resource = "sppr204"
    END

END
// SR_CONFIG_GUARD_END change:divine.charm_person_or_animal
